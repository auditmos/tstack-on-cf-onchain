// IMPORTANT:
// - Secrets: set via `wrangler secret put <NAME>` (or Dashboard > Settings > Variables and Secrets).
//   Do NOT put secrets in `vars` — they are not encrypted and end up in build output.
// - Non-secret server config: declare under `vars` here. Browser-exposed config goes through Vite as `VITE_*`.
// - Per-env overrides (worker name, vars, bindings): declare under `env.staging` / `env.production`.
//   Env-level fields are NOT inherited from the top level — re-declare every value each env needs
//   (including upload_source_maps, placement, and observability — verify in dist/server/wrangler.json
//   after building, since a value present only in source and not in the built manifest is not enabled).
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tanstack-start-app",
	"compatibility_date": "2026-05-26",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./src/server.ts",
	"vars": {
		"CLOUDFLARE_ENV": "dev",
		// Comma-separated list of origins the API's CORS middleware allows. Dev talks to
		// the local Vite dev server on the same default port.
		"ALLOWED_ORIGINS": "http://localhost:3000"
	},
	// Stack traces point at original source instead of an offset into the minified bundle.
	"upload_source_maps": true,
	"observability": {
		"enabled": true,
		// Dev is low-traffic and actively debugged — log everything.
		"logs": { "head_sampling_rate": 1 }
	},
	// Rate Limiting binding for the API middleware chain (src/hono/middleware/rate-limit.ts) —
	// this repo's first Cloudflare binding, and its worked example: `name` is the binding key
	// exposed on `env`, `namespace_id` is an arbitrary local identifier you pick (not a
	// provisioned resource id — no `wrangler` create step needed), and `simple.limit`/`period`
	// are requests-per-window. Because env-level config does NOT inherit from top level on this
	// platform, this binding must be re-declared in every `env.*` block below, or that
	// environment's Worker throws at request time the first time rate limiting runs.
	"ratelimits": [
		{ "name": "API_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } }
	],
	"env": {
		"staging": {
			"name": "tanstack-start-app-staging",
			"vars": {
				"CLOUDFLARE_ENV": "staging",
				// Set this to your staging frontend's origin once you have one deployed.
				"ALLOWED_ORIGINS": ""
			},
			"upload_source_maps": true,
			// Runs near the single-region Neon database it round-trips to on every request.
			"placement": { "mode": "smart" },
			"observability": {
				"enabled": true,
				// Staging has staging-sized traffic and exists to catch bugs before prod — log everything.
				"logs": { "head_sampling_rate": 1 }
			},
			// Re-declared: env-level bindings are NOT inherited from top level — see the note above.
			"ratelimits": [
				{
					"name": "API_RATE_LIMITER",
					"namespace_id": "1001",
					"simple": { "limit": 100, "period": 60 }
				}
			]
		},
		"production": {
			"name": "tanstack-start-app-production",
			"vars": {
				"CLOUDFLARE_ENV": "production",
				// Set this to your production frontend's origin(s) once you go live.
				"ALLOWED_ORIGINS": ""
			},
			"upload_source_maps": true,
			// Runs near the single-region Neon database it round-trips to on every request.
			"placement": { "mode": "smart" },
			"observability": {
				"enabled": true,
				// Production traffic volume makes 100% sampling costly; 10% is enough signal for
				// error-rate and latency trends without paying to log every request.
				"logs": { "head_sampling_rate": 0.1 }
			},
			// Re-declared: env-level bindings are NOT inherited from top level — see the note above.
			"ratelimits": [
				{
					"name": "API_RATE_LIMITER",
					"namespace_id": "1001",
					"simple": { "limit": 100, "period": 60 }
				}
			],
			// Reachable at tanstack-start-app-production.<subdomain>.workers.dev until a
			// custom domain is attached below. Safe default for a template repo: every
			// fork deploys successfully with zero DNS setup. Set to false once the
			// custom_domain route below is live, if workers.dev access should stop working.
			"workers_dev": true,
			// Off by default: a Version's preview URL (<version>-<name>.<subdomain>.workers.dev)
			// serves that version's code before it has been promoted to production traffic.
			// Leaving this on would make not-yet-promoted production code publicly reachable.
			"preview_urls": false
			// Uncomment and set your domain to go live on a custom domain instead of (or in
			// addition to) the workers.dev hostname above. `custom_domain: true` auto-creates
			// the DNS record and SSL cert — see .claude/rules/cloudflare-deployment.md.
			// "routes": [{ "pattern": "app.example.com", "custom_domain": true }]
		}
	}
}
