# Wrangler CLI credentials (used by `wrangler deploy` etc.).
# Optional if you authenticate via `wrangler login` instead.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Vite-side environment variables (browser bundle).
# Copy to `.env` and fill in. `VITE_*` is the only prefix Vite exposes to the client.
# Worker-side bindings (DATABASE_HOST, etc.) live in `.dev.vars` — see `.example.vars`.

# EVM chain the app connects to.
# Supported: 1 (mainnet), 11155111 (sepolia), 31337 (anvil).
# Add more by extending `SUPPORTED` in `src/lib/web3/chains.ts`.
VITE_CHAIN_ID=31337

# WalletConnect Cloud project id — required by ConnectKit / wagmi for WalletConnect v2.
# Create one at https://cloud.walletconnect.com (free).
# Leave blank locally if you only use injected wallets (MetaMask, Rabby, etc.).
VITE_WALLETCONNECT_PROJECT_ID=

# Optional per-chain RPC endpoint override: VITE_RPC_URL_<chainId>.
# Tried first; a public endpoint is always the last-resort fallback, so an
# unconfigured fork still works with no setup. See src/lib/web3/rpc-transport.ts.
# These are browser-exposed by the VITE_ prefix — never put a paid/secret
# endpoint here. If server-side chain access is ever added, that endpoint
# must be a Worker secret instead, not a client-visible variable.
# VITE_RPC_URL_1=
# VITE_RPC_URL_11155111=
# VITE_RPC_URL_31337=
